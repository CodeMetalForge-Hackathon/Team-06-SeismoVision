{
  "camera": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "warmup_seconds": 2.0
  },
  "reference_roi": [20, 40, 220, 220],
  "targets": [
    {
      "name": "roofline",
      "roi": [720, 100, 180, 180],
      "baseline_hz": 1.2,
      "frequency_shift_fraction_limit": 0.15,
      "relative_displacement_px_limit": null
    },
    {
      "name": "mid_facade",
      "roi": [720, 360, 180, 180],
      "baseline_hz": 1.2,
      "frequency_shift_fraction_limit": 0.15,
      "relative_displacement_px_limit": null
    }
  ],
  "analysis": {
    "window_seconds": 30.0,
    "minimum_samples": 180,
    "min_frequency_hz": 0.2,
    "max_frequency_hz": 5.0,
    "minimum_track_points": 6,
    "max_camera_motion_px": 1.5,
    "camera_settle_frames": 15,
    "minimum_confidence": 0.65
  },
  "magnification": {
    "enabled": true,
    "target": "roofline",
    "alpha": 8.0,
    "pyramid_levels": 3,
    "low_hz": 0.4,
    "high_hz": 3.0
  },
  "output": {
    "directory": "evidence",
    "save_video": true,
    "show_preview": true
  }
}
